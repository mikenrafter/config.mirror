module Custom.Scratch where

import Custom.Vars

import XMonad
import XMonad.Util.NamedScratchpad
import qualified XMonad.StackSet as W



mscratch' =
 [ "t", "<Space>", "n", "m", "f", "p" ]
-- NO letter S, unless you manually override letter assignment, see sp

mscratch =
 [ NS (s!1) t tF dC
 , NS (s!2) sp spF dC
 , NS (s!3) n nF dC
 , NS (s!4) m mF dC
 , NS (s!5) f fF dC
 , NS (s!6) p pF dC
 ]
 where
  s = mscratch'
  sn = [ "S:" ++ (caps x) | x <- s ]
  dC = customFloating $ W.RationalRect l t w h
   where
    h = 0.9
    w = 0.9
    t = 0.95 -h
    l = 0.95 -w

  t  = mconsole (sn!1) mshell
  tF = resource =? (sn!1) <||> title =? (sn!1)

  sp  = mconsole "S:S" $ "screen -xaAR scratch -s " ++ mshell
  spF = resource =? "S:S" <||> title =? "S:S"

  n  = mconsole (sn!3) meditor'  -- assumes CLI
  nF = resource =? (sn!3) <||> title =? (sn!3)

  m  = "vlc"
  mF = resource ~? "vlc"

  f  = mfiles
  fF = className ~? mfiles

  p  = "bitwarden"
  pF = className ~? "bitwarden"
