#!/bin/env fish
while echo 1 &>/dev/null
	if fish_is_root_user
		set interface (wg show | head -n1 | string split ' ' | tail -n1)
	else
		set interface (wg show 2>&1 >/dev/null | string split ' ' | grep ':' | sed 's/://g')
	end
	if test -n "$interface"
		sudo wg-quick down $interface &>/dev/null || break
		echo "removed $interface"
	else
		break
	end
end
sleep 1
[ "$argv[1]" = "" ] ||
	sudo wg-quick up $argv[1]

