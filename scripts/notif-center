#!/bin/env fish
set -l pid (pidof deadd-notification-center)

# only launch if another instance isn't there
if test "$pid" = ""
	SHELL=/bin/bash deadd-notification-center &
	vpnButton init
	#btButton init
	#netButton init
end
# only run if it isn't set to init mode
if test "$argv[1]" != "init"
	kill -s USR1 $pid
end
