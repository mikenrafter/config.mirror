#!/bin/bash
# allow passing in mhome, from xmonad
if [ "$1" == "" ]; then
	home=$HOME
else
	home=$1
fi

# compatibility
export SHELL=/bin/bash

### ### ### ###
# dis == stay on restart
# uni == kill any other instances before running
### ### ### ###


# DIS {
# map keybindings correctly
dis xmodmap $home/.Xmodmap
# }
# DIS UNI {
# improve playerctl pause-play intelligence
dis uni playerctld
# 10% nice halt, 7% forceful halt -- prefer killing web processes -- avoid
# common important programs
dis uni earlyoom -m 10,7 -s 20 -n --prefer "Web Content|java" --avoid "alacritty|(ba|fi)sh|getty|xmonad|vim"
# start easyeffects in the background by default -- give it higher priority,
# otherwise it's quality degrades under strain.
dis uni nice -n -15 easyeffects --gapplication-service
# }
# UNI {
# touchpad gestures
uni touchegg &
# compositor
uni picom &
# clipboard manager
uni clipit &
# conky mmmh
uni conky -c ~/.config/conky/nord.conkyrc &
# notification center
uni notif-center init &
# polkit
uni /usr/lib/xfce-polkit/xfce-polkit & # TODO: create nix derivation for
# make appimages work
uni appimagelauncherd &
# manage thumb-drives nicely
uni usermount &
# }
# & only {
# dies on restart
# keep awake button
caffeine &
# bluetooth connector
blueman-applet &
# network manager
nm-applet &
# kde connect indicator
kdeconnect-indicator &
# allow optimus to function + applet
prime-offload & \
	optimus-manager-qt &
# screenshot tool daemon
flameshot &
# }
# linear {
# quick-exit things
# connect to vpn on startup
vpn-button init && vpn `cat $home/.wg-default`
# background
#nitrogen 
# see scripts/wm
#nitrogen --random --set-zoom-fill
# }
